# =============================================================================
# DHubBW – Deployment Konfiguration
# =============================================================================
#
# Diese Datei wird von `deploy/docker-compose.yml` eingelesen.
# Vorgehen:
#   1) Datei nach `.env` kopieren:   cp .env.example .env
#   2) Bei Bedarf Werte anpassen (siehe Kommentare unten).
#   3) `docker compose -f deploy/docker-compose.yml up -d`
#
# HINWEIS: Die Default-Werte sind ausdrücklich für Test-/Demo-Deployments
# gedacht (keine Produktivumgebung). Für einen produktiven Einsatz MUSS
# zumindest POSTGRES_PASSWORD und JWT_SECRET geändert werden.
# =============================================================================


# -----------------------------------------------------------------------------
# Datenbank (PostgreSQL 17)
# -----------------------------------------------------------------------------
POSTGRES_DB=dhubbw
POSTGRES_USER=dhubbw
POSTGRES_PASSWORD=dhubbw-demo-pw

# Host-Verzeichnis für die DB-Daten (wird in den Container nach
# /var/lib/postgresql/data gemountet). Auf der Projekt-VM bleibt es bei
# /opt/projects/devstack/db/data (Default, wenn die Variable in der .env
# fehlt). Externe Deployer setzen hier z.B. ./pgdata relativ zur
# docker-compose.yml.
POSTGRES_DATA_DIR=./pgdata


# -----------------------------------------------------------------------------
# Backend (Spring Boot)
# -----------------------------------------------------------------------------
# JWT-Signaturschlüssel. Mindestens 32 Zeichen. Beim Deployment unbedingt
# durch einen eigenen Zufallswert ersetzen, z.B.:
#   openssl rand -base64 48
JWT_SECRET=change-me-please-this-is-only-a-demo-jwt-secret-32+chars


# -----------------------------------------------------------------------------
# Container-Images
# -----------------------------------------------------------------------------
# Per Default werden die offiziellen Images aus der GitLab Container Registry
# der Gruppe gezogen. Wer eigene/lokale Builds verwenden möchte, überschreibt
# diese Variablen entsprechend (z.B. `dhubbw-backend:latest`).
BACKEND_IMAGE=registry.gitlab.com/dhbw-se/se-tinf24b2/gruppe-4/dhubbw/backend:latest
FRONTEND_IMAGE=registry.gitlab.com/dhbw-se/se-tinf24b2/gruppe-4/dhubbw/frontend:latest


# -----------------------------------------------------------------------------
# Frontend / Reverse Proxy
# -----------------------------------------------------------------------------
# Host-Ports, auf denen der nginx im Frontend-Container lauscht.
# Falls Port 80/443 belegt sind, z.B. auf 8081/8443 umstellen.
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443

# Pfade zu Let's-Encrypt-Zertifikaten und Webroot. Auf der Produktiv-VM
# liegen die Zertifikate unter /etc/letsencrypt. Für ein lokales
# HTTP-only-Deployment können die Pfade auf leere Dummy-Verzeichnisse
# zeigen (z.B. `./empty`) oder die volumes in der compose-Datei entfernt
# werden, nginx serviert dann nur Port 80.
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=/var/www/certbot
